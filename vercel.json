{
  "outputDirectory": ".",
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(exclude)test' ':(exclude)tools' ':(exclude)supabase' ':(exclude)_pausa' ':(exclude)*.md' ':(exclude).impeccable' ':(exclude).gitignore'",
  "redirects": [
    {
      "source": "/",
      "destination": "https://moyiq.app/inversiones",
      "permanent": true
    },
    {
      "source": "/index.html",
      "destination": "https://moyiq.app/inversiones",
      "permanent": true
    },
    {
      "source": "/landing",
      "destination": "https://moyiq.app/inversiones",
      "permanent": true
    },
    {
      "source": "/app",
      "destination": "https://app.moyiq.app/app/?open=invest-resumen",
      "permanent": true
    },
    {
      "source": "/app/(.*)",
      "destination": "https://app.moyiq.app/app/?open=invest-resumen",
      "permanent": true
    },
    {
      "source": "/faq.html",
      "destination": "https://moyiq.app/inversiones",
      "permanent": true
    },
    {
      "source": "/perfil-inversor.html",
      "destination": "https://moyiq.app/inversiones",
      "permanent": true
    },
    {
      "source": "/estado-mercado.html",
      "destination": "https://moyiq.app/inversiones",
      "permanent": true
    },
    {
      "source": "/docs",
      "destination": "https://moyiq.app/inversiones",
      "permanent": true
    },
    {
      "source": "/docs/(.*)",
      "destination": "https://moyiq.app/inversiones",
      "permanent": true
    },
    {
      "source": "/_pausa",
      "destination": "https://moyiq.app/inversiones",
      "permanent": true
    },
    {
      "source": "/_pausa/(.*)",
      "destination": "https://moyiq.app/inversiones",
      "permanent": true
    },
    {
      "source": "/(.*)\\.md",
      "destination": "https://moyiq.app/inversiones",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/icon-32.png"
    }
  ],
  "headers": [
    {
      "source": "/app",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/app/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/privacy.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/terms.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        },
        {
          "key": "Content-Type",
          "value": "application/javascript"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=60"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://us-assets.i.posthog.com https://eu-assets.i.posthog.com https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; connect-src 'self' https://*.supabase.co https://us.i.posthog.com https://eu.i.posthog.com; font-src 'self' https://fonts.gstatic.com data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; frame-ancestors 'none'; base-uri 'self'"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/api/img",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, immutable"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    }
  ]
}
